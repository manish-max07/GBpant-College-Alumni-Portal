# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gbpantalumni
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h


# Email Configuration (for OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Enhanced Email Security Configuration
EMAIL_RATE_LIMIT_WINDOW=900000  # 15 minutes in milliseconds
EMAIL_RATE_LIMIT_MAX=5          # Max emails per window per IP
EMAIL_FREQUENCY_LIMIT_WINDOW=300000  # 5 minutes in milliseconds  
EMAIL_FREQUENCY_LIMIT_MAX=3     # Max emails per window per IP
PASSWORD_RESET_RATE_LIMIT_WINDOW=3600000  # 1 hour in milliseconds
PASSWORD_RESET_RATE_LIMIT_MAX=3 # Max password reset attempts per hour

# Advanced Security Settings
SUSPICIOUS_IP_BLOCK_DURATION=86400000  # 24 hours in milliseconds
HIGH_FREQUENCY_REQUEST_THRESHOLD=20    # Requests that trigger suspicious behavior
HIGH_FREQUENCY_TIME_WINDOW=300000      # 5 minutes in milliseconds
PATTERN_ANALYSIS_ENABLED=true          # Enable automated pattern detection
HONEYPOT_ENABLED=true                  # Enable honeypot fields

# CAPTCHA Configuration
CAPTCHA_SALT=gbpant_alumni_captcha_salt_2024_make_this_unique_and_secret
SKIP_CAPTCHA=false

# Server Configuration
PORT=5000
# Alternative ports if 5000 is busy: 3001, 8000, 8080, 3030
NODE_ENV=development

# Rate Limiting
CAPTCHA_RATE_LIMIT_WINDOW=60000
CAPTCHA_RATE_LIMIT_MAX=10

# OTP Configuration
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=3
MAX_VERIFY_ATTEMPTS=3

# Admin Authorization Configuration
ADMIN_EMAIL=your_admin_email@gmail.com
