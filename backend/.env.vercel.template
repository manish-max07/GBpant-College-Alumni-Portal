# Vercel Environment Variables Template
# Copy these to Vercel Dashboard → Settings → Environment Variables

# =============================================================================
# DATABASE CONFIGURATION (Supabase)
# =============================================================================
DATABASE_URL=postgresql://postgres.your_supabase_id:your_db_password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your_supabase_id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# =============================================================================
# 📧 SMTP EMAIL CONFIGURATION (WORKS ON VERCEL!)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h

# =============================================================================
# FILE STORAGE (Cloudinary)
# =============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
FRONTEND_URL=https://gbpant-alumni-portal-new.onrender.com

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================
CAPTCHA_SALT=gbpant_alumni_captcha_salt_2024_make_this_unique_and_secret
MAX_OTP_ATTEMPTS=3
MAX_VERIFY_ATTEMPTS=3
OTP_EXPIRE_MINUTES=10

EMAIL_FREQUENCY_LIMIT_MAX=3
EMAIL_FREQUENCY_LIMIT_WINDOW=300000
EMAIL_RATE_LIMIT_MAX=5
EMAIL_RATE_LIMIT_WINDOW=900000

CAPTCHA_RATE_LIMIT_MAX=10
CAPTCHA_RATE_LIMIT_WINDOW=60000

PASSWORD_RESET_RATE_LIMIT_MAX=3
PASSWORD_RESET_RATE_LIMIT_WINDOW=3600000

HIGH_FREQUENCY_REQUEST_THRESHOLD=20
HIGH_FREQUENCY_TIME_WINDOW=300000
SUSPICIOUS_IP_BLOCK_DURATION=86400000

# =============================================================================
# SECURITY FEATURES
# =============================================================================
HONEYPOT_ENABLED=true
SKIP_CAPTCHA=false
PATTERN_ANALYSIS_ENABLED=true
ADMIN_EMAIL=your_admin_email@gmail.com

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 1. Copy each variable above to Vercel dashboard (exclude comments)
# 2. Vercel supports SMTP on ports 587/465 (only blocks port 25)
# 3. SMTP emails will work perfectly on Vercel free tier!
# 4. After deployment, update FRONTEND_URL to your Vercel backend URL