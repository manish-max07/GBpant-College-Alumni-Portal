{
  "name": "gbpant-alumni-portal-backend",
  "version": "1.0.0",
  "description": "Backend for GBPANT Alumni Portal with CAPTCHA support",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'Build completed for Vercel'",
    "vercel-build": "echo 'Vercel build step completed'",
    "test": "node tests/test-captcha.js",
    "test-smtp": "node tests/test-smtp-email.js",
    "test-db": "node scripts/test-database.js",
    "setup-db": "node scripts/setup-database.js",
    "migrate-jwt": "node scripts/migrate-to-jwt.js",
    "db-health": "node -e \"require('./utils/database-manager').healthCheck()\"",
    "check-port": "scripts/check-port.bat",
    "kill-port": "scripts/kill-port.bat"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "resend": "^6.1.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2"
  },
  "keywords": [
    "nodejs",
    "express",
    "captcha",
    "alumni",
    "portal",
    "authentication"
  ],
  "author": "GBPANT Alumni Portal Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  }
}
