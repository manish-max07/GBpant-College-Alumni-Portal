# Frontend Environment Variables for Render Deployment
# Copy these to Render Dashboard -> Environment Variables

# =============================================================================
# API Configuration
# =============================================================================
# Railway Backend URL (YOUR NEW BACKEND)
VITE_API_URL=https://gbpant-alumni-portal-production.up.railway.app

# Alternative: Keep using Render backend
# VITE_API_URL=https://gbpant-alumni-portal.onrender.com

# =============================================================================
# App Configuration
# =============================================================================
VITE_APP_TITLE=GB Pant College Alumni Portal
VITE_NODE_ENV=production

# =============================================================================
# DEPLOYMENT INSTRUCTIONS
# =============================================================================

# For Render Frontend Deployment:
# 1. Go to Render Dashboard -> Your Frontend Service
# 2. Settings -> Environment Variables
# 3. Add each variable above (without comments)
# 4. Make sure VITE_API_URL points to your Railway backend
# 5. Redeploy frontend service

# For Local Development (.env.local):
# VITE_API_URL=http://localhost:5000
# VITE_APP_TITLE=GB Pant College Alumni Portal (Dev)
# VITE_NODE_ENV=development

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# 1. Vite requires VITE_ prefix for environment variables
# 2. Always include https:// in VITE_API_URL for production
# 3. After changing API URL, frontend needs to be redeployed
# 4. Test API connection after deployment